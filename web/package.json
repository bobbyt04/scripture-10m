{
  "name": "scripture-10m-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "extract": "node scripts/extract.ts",
    "dev": "npm run extract && vite --port 5300 --strictPort",
    "build": "npm run extract && vite build",
    "preview": "vite preview --port 5301 --strictPort",
    "typecheck": "npm run extract && tsc --noEmit",
    "test": "npm run extract && vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
